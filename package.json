{
  "name": "llm-audit",
  "version": "0.11.0",
  "description": "Static analysis for LLM-application code. OWASP LLM Top 10 at commit time.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Javierlozo/llm-audit.git"
  },
  "bugs": {
    "url": "https://github.com/Javierlozo/llm-audit/issues"
  },
  "homepage": "https://llm-audit.luislozoya.com",
  "type": "module",
  "bin": {
    "llm-audit": "src/cli.mjs"
  },
  "files": [
    "src",
    "rules",
    "templates",
    "assets",
    "test/fixtures",
    "skills",
    "docs/RULES.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "scan": "node src/cli.mjs scan",
    "demo:svg": "node tools/make-scan-demo.mjs",
    "commands:svg": "node tools/make-command-map.mjs",
    "test": "node test/run-fixtures.mjs && node test/run-cli.mjs",
    "test:rules": "node test/run-fixtures.mjs",
    "test:cli": "node test/run-cli.mjs"
  },
  "keywords": [
    "llm",
    "llm-security",
    "ai-security",
    "security",
    "static-analysis",
    "sast",
    "semgrep",
    "owasp",
    "owasp-llm-top-10",
    "prompt-injection",
    "typescript",
    "javascript",
    "nextjs",
    "vercel-ai-sdk",
    "openai",
    "anthropic",
    "langchain",
    "pre-commit",
    "github-action",
    "sarif"
  ],
  "author": {
    "name": "Luis Javier Lozoya",
    "url": "https://www.luislozoya.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "semgrep": "*"
  },
  "peerDependenciesMeta": {
    "semgrep": {
      "optional": true
    }
  }
}
