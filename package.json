{
  "name": "llm-audit",
  "version": "0.0.10",
  "description": "Static analysis for LLM-application code. OWASP LLM Top 10 at commit time.",
  "type": "module",
  "bin": {
    "llm-audit": "src/cli.mjs"
  },
  "files": [
    "src",
    "rules",
    "templates",
    "test/fixtures",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "scan": "node src/cli.mjs scan",
    "test": "node test/run-fixtures.mjs"
  },
  "keywords": [
    "llm",
    "security",
    "static-analysis",
    "semgrep",
    "owasp",
    "prompt-injection",
    "ai-security",
    "sast"
  ],
  "author": {
    "name": "Luis Javier Lozoya",
    "url": "https://www.luislozoya.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "semgrep": "*"
  },
  "peerDependenciesMeta": {
    "semgrep": {
      "optional": true
    }
  }
}
