#!/usr/bin/env sh
# Installed by `npx llm-audit init`. Runs the rule pack on staged files only,
# so it stays fast on large repos.
#
# Uses null-delimited filenames so that filenames containing spaces, glob
# metacharacters, or other shell-significant bytes are passed verbatim to
# semgrep instead of being word-split or glob-expanded by the shell.

set -eu

git diff --cached --name-only --diff-filter=ACMR -z |
  grep -zE '\.(js|jsx|ts|tsx|mjs|cjs)$' |
  xargs -0 -r npx --no-install llm-audit scan --
